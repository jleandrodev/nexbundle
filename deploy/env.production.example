# Copie para .env.production (na VPS) e preencha. NÃO versione o .env.production.
# Em produção o Shopify CLI NÃO injeta nada — você seta tudo aqui.

# --- Credenciais do app (Partners → app → API credentials / Client) ---
SHOPIFY_API_KEY=            # = client_id do app
SHOPIFY_API_SECRET=         # client secret

# --- URL pública do backend (seu domínio, com https) ---
# DEVE bater com application_url registrado no Dashboard e com app_proxy.url no toml.
SHOPIFY_APP_URL=https://app.seudominio.com

# --- Scopes (iguais ao shopify.app.toml) ---
SCOPES=read_products

# --- Banco: SQLite PERSISTENTE, fora do diretório de deploy (sobrevive a redeploy) ---
DATABASE_URL=file:/var/data/buy-together/prod.sqlite

# --- Porta local que o PM2/Remix escuta (o Nginx faz proxy pra ela) ---
PORT=3000
NODE_ENV=production
