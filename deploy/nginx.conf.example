# Nginx — reverse proxy para o backend Remix (PM2 na porta 3000).
# Troque app.seudominio.com pelo seu domínio. Instale o TLS com certbot:
#   sudo certbot --nginx -d app.seudominio.com
#
# ⚠️ NÃO adicione `X-Frame-Options` aqui: apps Shopify são embutidos em iframe no
#    admin; o próprio app define o frame-ancestors correto (gotcha #16). Adicionar
#    X-Frame-Options quebra o embedding ("não pode abrir esta página").

server {
    listen 80;
    server_name app.seudominio.com;
    # certbot cuida do redirect 80->443 ao instalar o cert.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 90s;
    }

    client_max_body_size 5m;
}
