// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  // Dev: file:dev.sqlite (via .env). Prod: caminho persistente FORA do dir de deploy
  // (ex.: DATABASE_URL="file:/var/data/buy-together/prod.sqlite"). Ver deploy/DEPLOY.md.
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// -------- Buy Together --------
// Multi-tenant: TODA tabela do app carrega `shop` e é sempre filtrada por ele.

// Relacionamento "compre junto": 1 produto principal -> N companheiros (1:N).
model Relationship {
  id            String      @id @default(cuid())
  shop          String
  name          String      @default("") // nome do componente (facilita a listagem)
  mainProductId String // gid://shopify/Product/123
  enabled       Boolean     @default(true)
  layout        String      @default("A") // legado (A|B). Substituído por `template`.
  template      String      @default("side-by-side") // side-by-side | list | compact
  style         String      @default("{}") // JSON com ComponentStyle (cores, título, borda...)
  direction     String      @default("uni") // uni = só no principal | bi = nos dois produtos (A<->B)
  // Desconto do bundle: exibido no componente E aplicado no checkout pela Shopify Function
  // (extensions/buy-together-discount). `discountValue` = % quando percentage, valor na
  // moeda da loja quando fixed. Ver services/discounts.server.ts.
  discountType  String      @default("none") // none | percentage | fixed
  discountValue Float       @default(0)
  companions    Companion[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Vários componentes podem ter o MESMO produto principal (ex.: kits diferentes).
  // A vitrine mostra o 1º ativo do produto (ver resolveForProduct).
  @@index([shop])
  @@index([shop, mainProductId])
}

model Companion {
  id                 String       @id @default(cuid())
  relationshipId     String
  relationship       Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  companionProductId String // gid do produto companheiro
  companionVariantId String? // opcional; senão resolve a 1ª variante disponível
  position           Int          @default(0)

  @@index([relationshipId])
}

// Preferências do lojista por loja (1 registro por shop). Ex.: idioma do painel admin.
model ShopPreference {
  shop        String   @id
  adminLocale String? // "pt-BR" | "en" | "es" | null = seguir o idioma do Shopify
  updatedAt   DateTime @updatedAt
}

// Desconto automático (Shopify Function) criado pelo app na loja — 1 por shop.
// Guardamos o gid do DiscountAutomaticNode para atualizar o metafield de configuração
// sem precisar varrer a lista de descontos a cada save.
model AppDiscount {
  shop       String   @id
  nodeId     String // gid://shopify/DiscountAutomaticNode/...
  functionId String // id da Shopify Function usada na criação
  updatedAt  DateTime @updatedAt
}

// Config de estilo GLOBAL por loja (1 registro por shop). Defaults = comportamento seguro.
model StylingConfig {
  shop            String   @id
  backgroundColor String   @default("#ffffff")
  textColor       String   @default("#1a1a1a")
  titleColor      String   @default("#1a1a1a")
  buttonColor     String   @default("#000000")
  buttonTextColor String   @default("#ffffff")
  addButtonText   String   @default("Adicionar ambos ao carrinho")
  titleText       String   @default("Compre junto")
  updatedAt       DateTime @updatedAt
}

// Event log cru de métricas -> agregação por groupBy no painel.
model MetricEvent {
  id                 String   @id @default(cuid())
  shop               String
  type               String // "impression" | "click"
  mainProductId      String
  companionProductId String?
  layout             String? // A | B
  createdAt          DateTime @default(now())

  @@index([shop, mainProductId, type])
  @@index([shop, createdAt])
}

// -------- Suporte / Chat --------
// Conversa contínua por loja (1 thread por shop). Não-lidas derivadas dos *LastReadAt.
model Conversation {
  id                String    @id @default(cuid())
  shop              String    @unique
  status            String    @default("open") // open | closed
  lastMessageAt     DateTime  @default(now())
  merchantLastReadAt DateTime?
  staffLastReadAt   DateTime?
  assignedStaffId   String?
  // Marco do ticket atual. Ao encerrar um ticket, resetAt = now: as mensagens
  // anteriores ficam salvas no banco, mas somem da conversa ativa (lojista e equipe),
  // e o próximo contato do lojista dispara a mensagem automática de novo.
  resetAt           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([lastMessageAt])
}

model SupportMessage {
  id          String              @id @default(cuid())
  shop        String
  sender      String // "merchant" | "staff"
  staffUserId String?
  automated   Boolean             @default(false) // true = mensagem automática (não é resposta humana)
  body        String
  attachments SupportAttachment[]
  createdAt   DateTime            @default(now())

  @@index([shop, createdAt])
}

model SupportAttachment {
  id        String          @id @default(cuid())
  shop      String
  messageId String?
  message   SupportMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  size      Int
  path      String // caminho no disco (UPLOAD_DIR/<id>)
  createdAt DateTime        @default(now())

  @@index([shop])
  @@index([messageId])
}

// Equipe de atendimento (global — não é por loja).
model StaffUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}
