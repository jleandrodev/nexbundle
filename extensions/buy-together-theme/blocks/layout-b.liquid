{% comment %}
  Buy Together — Layout B ("compacto")
  Só infos do companheiro + botão "adicionar ambos". Feito para arrastar para dentro
  da product-information section, acima ou abaixo do botão comprar.
  Mesmo asset JS decide o render por data-bt-layout.
{% endcomment %}
<div
  class="bt-root bt-layout-b"
  data-bt-layout="B"
  data-bt-product-id="{{ product.id }}"
  data-bt-variant-id="{{ product.selected_or_first_available_variant.id }}"
  data-bt-variant-price="{{ product.selected_or_first_available_variant.price }}"
  data-bt-money-format="{{ shop.money_format | escape }}"
  hidden
>
  <div class="bt-skeleton" aria-hidden="true">{{ block.settings.loading_text }}</div>
</div>

{% schema %}
{
  "name": "Compre junto compacto",
  "target": "section",
  "stylesheet": "buy-together.css",
  "javascript": "buy-together.js",
  "settings": [
    {
      "type": "text",
      "id": "loading_text",
      "label": "Texto de carregamento",
      "default": "Carregando sugestão..."
    }
  ]
}
{% endschema %}
