{% comment %}
  Buy Together — Layout A ("lado a lado")
  Card do produto principal + card do companheiro + card lateral com a SOMA + botão.
  Arrastável em qualquer section que suporte @app (ex.: product page do Dawn).
  Dados e cores vêm da config global via App Proxy (buy-together.js).
{% endcomment %}
<div
  class="bt-root bt-layout-a"
  data-bt-layout="A"
  data-bt-template="side-by-side"
  data-bt-product-id="{{ product.id }}"
  data-bt-variant-id="{{ product.selected_or_first_available_variant.id }}"
  data-bt-variant-price="{{ product.selected_or_first_available_variant.price }}"
  data-bt-money-format="{{ shop.money_format | escape }}"
  data-bt-i18n-total="{{ 'buy_together.total' | t | escape }}"
  data-bt-i18n-total-price="{{ 'buy_together.total_price' | t | escape }}"
  data-bt-i18n-total-two="{{ 'buy_together.total_two' | t | escape }}"
  data-bt-i18n-you-save="{{ 'buy_together.you_save' | t | escape }}"
  data-bt-i18n-add-all="{{ 'buy_together.add_all' | t | escape }}"
  data-bt-i18n-add-cart="{{ 'buy_together.add_to_cart' | t | escape }}"
  data-bt-i18n-buy-now="{{ 'buy_together.buy_now' | t | escape }}"
  data-bt-i18n-increase="{{ 'buy_together.increase' | t | escape }}"
  data-bt-i18n-decrease="{{ 'buy_together.decrease' | t | escape }}"
  data-bt-i18n-sold-out="{{ 'buy_together.sold_out' | t | escape }}"
  data-bt-i18n-add-error="{{ 'buy_together.add_error' | t | escape }}"
  hidden
>
  <div class="bt-skeleton" aria-hidden="true">
    {%- if block.settings.loading_text != blank -%}
      {{ block.settings.loading_text }}
    {%- else -%}
      {{ 'buy_together.loading' | t }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "NexBundle — Side by side",
  "target": "section",
  "stylesheet": "buy-together.css",
  "javascript": "buy-together.js",
  "settings": [
    {
      "type": "text",
      "id": "loading_text",
      "label": "Loading text",
      "info": "Shown while the suggestion loads. Leave empty to use the automatic translation."
    }
  ]
}
{% endschema %}
